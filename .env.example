# Supabase Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Project Settings → API Keys → Publishable key
# This key may be exposed to browser code once authentication is added.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Supabase Project Settings → API Keys → Secret key
# Used only by trusted maintenance scripts such as `pnpm seed:supabase`.
# Never prefix this variable with NUXT_PUBLIC_ or expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me
